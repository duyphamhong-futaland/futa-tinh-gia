{
  "manifest_version": 3,
  "name": "FUTA Land — Xoá nhãn AI khỏi ảnh",
  "short_name": "Xoá nhãn AI",
  "version": "1.0.0",
  "description": "Gỡ metadata C2PA, IPTC, XMP, EXIF khiến Facebook/Instagram gắn nhãn “Thông tin về AI”. Xử lý ngay trên máy, không gửi ảnh đi đâu.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Xoá nhãn AI khỏi ảnh",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "minimum_chrome_version": "116"
}
